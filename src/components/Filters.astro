---
interface Props {
  categories: string[];
  sources: string[];
  contentTypes: string[];
}

const { categories, sources, contentTypes } = Astro.props;
---

<div class="card p-5">
  <div class="grid gap-4 md:grid-cols-4">
    <div class="md:col-span-2">
      <label for="search" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-wood-600">
        Поиск
      </label>
      <input
        id="search"
        type="search"
        placeholder="Поиск по заголовку и резюме…"
        class="w-full rounded-md border border-wood-200 bg-cream px-3 py-2 text-sm outline-none transition-colors focus:border-wood-500 focus:bg-white"
      />
    </div>

    <div>
      <label for="filter-category" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-wood-600">
        Рубрика
      </label>
      <select
        id="filter-category"
        class="w-full rounded-md border border-wood-200 bg-cream px-3 py-2 text-sm outline-none transition-colors focus:border-wood-500 focus:bg-white"
      >
        <option value="">Все рубрики</option>
        {categories.map(category => (
          <option value={category}>{category}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="filter-source" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-wood-600">
        Источник
      </label>
      <select
        id="filter-source"
        class="w-full rounded-md border border-wood-200 bg-cream px-3 py-2 text-sm outline-none transition-colors focus:border-wood-500 focus:bg-white"
      >
        <option value="">Все источники</option>
        {sources.map(source => (
          <option value={source}>{source}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="filter-type" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-wood-600">
        Тип
      </label>
      <select
        id="filter-type"
        class="w-full rounded-md border border-wood-200 bg-cream px-3 py-2 text-sm outline-none transition-colors focus:border-wood-500 focus:bg-white"
      >
        <option value="">Все типы</option>
        {contentTypes.map(type => (
          <option value={type}>{type}</option>
        ))}
      </select>
    </div>
  </div>

  <p id="filter-status" class="mt-3 text-xs text-wood-500">
    Показано <span id="filter-count">0</span> материалов
  </p>
</div>

<script>
  const search = document.getElementById('search') as HTMLInputElement | null;
  const category = document.getElementById('filter-category') as HTMLSelectElement | null;
  const source = document.getElementById('filter-source') as HTMLSelectElement | null;
  const type = document.getElementById('filter-type') as HTMLSelectElement | null;
  const count = document.getElementById('filter-count');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));

  function applyFilters() {
    const query = (search?.value ?? '').trim().toLowerCase();
    const cat = category?.value ?? '';
    const src = source?.value ?? '';
    const typ = type?.value ?? '';

    let visible = 0;
    for (const card of cards) {
      const matchQuery = !query || (card.dataset.search ?? '').includes(query);
      const matchCategory = !cat || card.dataset.category === cat;
      const matchSource = !src || card.dataset.source === src;
      const matchType = !typ || card.dataset.contentType === typ;

      const show = matchQuery && matchCategory && matchSource && matchType;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    }

    if (count) count.textContent = String(visible);
  }

  [search, category, source, type].forEach(element => {
    element?.addEventListener('input', applyFilters);
    element?.addEventListener('change', applyFilters);
  });

  applyFilters();
</script>
