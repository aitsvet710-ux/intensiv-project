---
import { CATEGORY_META } from '../lib/categories';

/**
 * Фильтры архива: поиск и чипы-пилюли по рубрике, источнику и типу.
 */
interface Props {
  categories: string[];
  sources: string[];
  contentTypes: string[];
}

const { categories, sources, contentTypes } = Astro.props;

const groups = [
  {
    key: 'category',
    label: 'Рубрика',
    options: categories.map(name => ({
      value: name,
      label: name,
      slug: CATEGORY_META[name as keyof typeof CATEGORY_META]?.slug ?? ''
    }))
  },
  {
    key: 'source',
    label: 'Источник',
    options: sources.map(name => ({ value: name, label: name, slug: '' }))
  },
  {
    key: 'type',
    label: 'Тип',
    options: contentTypes.map(name => ({ value: name, label: name, slug: '' }))
  }
];
---

<div class="card gap-5 p-5">
  <div>
    <label for="search" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-graphite-600">
      Поиск
    </label>
    <input
      id="search"
      type="search"
      placeholder="Поиск по заголовку и резюме…"
      class="w-full rounded-chip border border-sand-200 bg-paper px-4 py-2.5 text-sm text-graphite-900 outline-none transition-colors placeholder:text-graphite-400 focus:border-terracotta-500 focus:bg-white"
    />
  </div>

  {
    groups.map(group => (
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-graphite-600">
          {group.label}
        </p>
        <div class="relative" data-chips-wrap>
          <div class="chips-scroll">
            <button
              type="button"
              class="chip-active"
              data-filter={group.key}
              data-value=""
              data-slug=""
            >
              Все
            </button>
            {group.options.map(option => (
              <button
                type="button"
                class="chip-muted"
                data-filter={group.key}
                data-value={option.value}
                data-slug={option.slug}
              >
                {option.label}
              </button>
            ))}
          </div>
          <span
            class="pointer-events-none absolute inset-y-0 right-0 hidden w-8 bg-gradient-to-l from-white to-transparent sm:hidden"
            data-chips-fade
            aria-hidden="true"
          >
          </span>
        </div>
      </div>
    ))
  }

  <p class="text-xs text-graphite-500">
    Показано <span id="filter-count">0</span> <span id="filter-noun">материалов</span>
  </p>
</div>

<script>
  import { plural } from '../lib/utils';

  const search = document.getElementById('search') as HTMLInputElement | null;
  const count = document.getElementById('filter-count');
  const noun = document.getElementById('filter-noun');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));

  const active: Record<string, string> = { category: '', source: '', type: '' };

  function syncChips() {
    for (const chip of chips) {
      const group = chip.dataset.filter ?? '';
      const value = chip.dataset.value ?? '';
      const isActive = active[group] === value;
      chip.classList.toggle('chip-active', isActive);
      chip.classList.toggle('chip-muted', !isActive);
      chip.setAttribute('aria-pressed', String(isActive));
    }
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    const chip = chips.find(
      item => item.dataset.filter === 'category' && (item.dataset.value ?? '') === active.category
    );
    const slug = chip?.dataset.slug ?? '';
    if (slug) {
      url.searchParams.set('category', slug);
    } else {
      url.searchParams.delete('category');
    }
    window.history.replaceState({}, '', url);
  }

  function applyFilters() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const matchQuery = !query || (card.dataset.search ?? '').includes(query);
      const matchCategory = !active.category || card.dataset.category === active.category;
      const matchSource = !active.source || card.dataset.source === active.source;
      const matchType = !active.type || card.dataset.contentType === active.type;

      const show = matchQuery && matchCategory && matchSource && matchType;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    }

    if (count) count.textContent = String(visible);
    if (noun) {
      noun.textContent = plural(visible, 'материал', 'материала', 'материалов');
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const group = chip.dataset.filter ?? '';
      const value = chip.dataset.value ?? '';
      // повторное нажатие на активный чип снимает фильтр
      active[group] = active[group] === value ? '' : value;
      syncChips();
      applyFilters();
      updateUrl();
    });
  }

  search?.addEventListener('input', applyFilters);

  // Затухание края ленты чипов: показываем, пока есть что прокрутить вправо.
  const scrollers = Array.from(document.querySelectorAll<HTMLElement>('.chips-scroll'));

  function syncFades() {
    for (const scroller of scrollers) {
      const fade = scroller.parentElement?.querySelector<HTMLElement>('[data-chips-fade]');
      if (!fade) continue;
      const atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 2;
      fade.classList.toggle('hidden', atEnd);
    }
  }

  for (const scroller of scrollers) {
    scroller.addEventListener('scroll', syncFades, { passive: true });
  }
  window.addEventListener('resize', syncFades, { passive: true });
  syncFades();

  // Фильтр из адресной строки: /archive/?category=<slug>
  const slug = new URLSearchParams(window.location.search).get('category');
  if (slug) {
    const chip = chips.find(
      item => item.dataset.filter === 'category' && item.dataset.slug === slug
    );
    if (chip) {
      active.category = chip.dataset.value ?? '';
    }
  }

  syncChips();
  applyFilters();
</script>
