---
import type { Category, ContentType } from '../lib/types';

interface Props {
  category: Category | string;
  contentType?: ContentType | string;
  size?: 'sm' | 'md';
}

const { category, contentType, size = 'md' } = Astro.props;

const styles: Record<string, string> = {
  'Инструмент': 'bg-wood-100 text-wood-800',
  'Проект/чертёж': 'bg-amber-100 text-amber-900',
  'Техника и приёмы': 'bg-emerald-100 text-emerald-900',
  'Безопасность': 'bg-red-100 text-red-900',
  'События/выставки': 'bg-violet-100 text-violet-900',
  'Вдохновение': 'bg-sky-100 text-sky-900'
};

const badge = styles[category] ?? 'bg-wood-100 text-wood-800';
const typeBadge = 'bg-stone-200 text-stone-700';
---

<div class="flex flex-wrap items-center gap-2">
  <span class:list={['inline-flex items-center rounded-full font-medium', size === 'sm' ? 'px-2 py-0.5 text-xs' : 'px-2.5 py-1 text-sm', badge]}>
    {category}
  </span>
  {contentType && (
    <span class:list={['inline-flex items-center rounded-full font-medium', size === 'sm' ? 'px-2 py-0.5 text-xs' : 'px-2.5 py-1 text-sm', typeBadge]}>
      {contentType}
    </span>
  )}
</div>
