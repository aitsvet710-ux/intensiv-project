---
/**
 * Полоса метрик дайджеста: три числа с подписями и разделителями.
 * Значения считаются на этапе сборки — никаких захардкоженных значений.
 */
interface Props {
  /** Всего материалов в архиве. */
  materials: number;
  /** Сколько источников включено в конвейере. */
  sources: number;
  /** Дата последнего обновления — уже отформатирована по-русски. */
  updatedAt: string;
}

const { materials, sources, updatedAt } = Astro.props;

const items = [
  { label: 'Материалов', value: String(materials) },
  { label: 'Источников', value: String(sources) },
  { label: 'Обновлено', value: updatedAt }
];
---

<div
  class="grid grid-cols-1 divide-y divide-sand-200 rounded-card border border-sand-200 bg-white p-1 shadow-card sm:grid-cols-3 sm:divide-x sm:divide-y-0"
>
  {
    items.map(item => (
      <div class="px-5 py-4 text-center sm:px-6 sm:py-5">
        <p class="font-serif text-2xl font-bold leading-tight text-graphite-900 sm:text-3xl">
          {item.value}
        </p>
        <p class="mt-1 text-xs font-medium uppercase tracking-wide text-graphite-500">
          {item.label}
        </p>
      </div>
    ))
  }
</div>
