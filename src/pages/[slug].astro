---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { getAllMaterials, getMaterialBySlug } from '../lib/data';
import { formatDate, withBase } from '../lib/utils';

export function getStaticPaths() {
  return getAllMaterials().map(material => ({
    params: { slug: material.id },
    props: { material }
  }));
}

const { material } = Astro.props as { material: ReturnType<typeof getMaterialBySlug> };

if (!material) {
  return Astro.redirect('/archive/');
}

const related = getAllMaterials()
  .filter(item => item.id !== material.id && item.category === material.category)
  .slice(0, 3);
---

<BaseLayout title={material.title} description={material.summary ?? material.title}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a href={withBase('/archive/')} class="text-sm font-medium text-wood-600 hover:text-wood-900">← Ко всем материалам</a>

    <header class="mt-6">
      <Tag category={material.category} contentType={material.contentType} />
      <h1 class="mt-4 font-serif text-3xl font-bold leading-tight text-wood-900 sm:text-4xl">
        {material.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-wood-600">
        <span>Источник: <strong class="font-semibold text-wood-800">{material.source}</strong></span>
        <time datetime={material.publishedAt}>{formatDate(material.publishedAt)}</time>
      </div>
    </header>

    {material.imageUrl && (
      <img
        src={material.imageUrl}
        alt={material.title}
        loading="lazy"
        class="mt-8 w-full rounded-lg border border-wood-200 object-cover"
      />
    )}

    {material.summary && (
      <section class="mt-8 rounded-lg border-l-4 border-wood-500 bg-wood-50 p-6">
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-wood-600">Коротко</h2>
        <p class="text-base leading-relaxed text-wood-800">{material.summary}</p>
      </section>
    )}

    {material.description && material.description !== material.summary && (
      <section class="mt-8">
        <h2 class="mb-3 font-serif text-xl font-bold text-wood-900">Подробнее</h2>
        <p class="leading-relaxed text-wood-700">{material.description}</p>
      </section>
    )}

    {material.tags && material.tags.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 font-serif text-xl font-bold text-wood-900">Теги</h2>
        <div class="flex flex-wrap gap-2">
          {material.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </section>
    )}

    <div class="mt-10 border-t border-wood-200 pt-8">
      <a href={material.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Открыть первоисточник →
      </a>
    </div>

    {related.length > 0 && (
      <aside class="mt-14 border-t border-wood-200 pt-8">
        <h2 class="mb-4 font-serif text-xl font-bold text-wood-900">Ещё в рубрике «{material.category}»</h2>
        <ul class="space-y-3">
          {related.map(item => (
            <li>
              <a
                href={withBase(`/${item.id}/`)}
                class="block rounded-md border border-wood-200 bg-white px-4 py-3 transition-colors hover:bg-wood-50"
              >
                <span class="font-medium text-wood-900">{item.title}</span>
                <span class="mt-1 block text-xs text-wood-500">{formatDate(item.publishedAt)}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>
