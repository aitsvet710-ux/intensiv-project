---
import BaseLayout from '../layouts/BaseLayout.astro';
import MaterialCard from '../components/MaterialCard.astro';
import { getFreshIssue, getAllMaterials } from '../lib/data';
import { withBase } from '../lib/utils';

const fresh = getFreshIssue(7, 7);
const all = getAllMaterials();
const fallback = fresh.length >= 3 ? fresh : all.slice(0, 7);
const issueDate = new Date().toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout>
  <section class="border-b border-wood-200 bg-wood-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-wood-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-wood-700">
        Свежий выпуск · {issueDate}
      </p>
      <h1 class="max-w-3xl font-serif text-3xl font-bold leading-tight text-wood-900 sm:text-5xl">
        Практичные находки для тех, кто работает с деревом
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-wood-700 sm:text-lg">
        Дайджест собирает свежие материалы из сообществ мастеров, отбирает то, что действительно
        пригодится в работе, и раскладывает по рубрикам: инструмент, чертежи, техника, безопасность.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={withBase('/archive/')} class="btn-primary">Все материалы</a>
        <a href="#fresh" class="btn border border-wood-300 text-wood-800 hover:bg-wood-100">Свежее за 7 дней</a>
      </div>
    </div>
  </section>

  <section id="fresh" class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="font-serif text-2xl font-bold text-wood-900">Свежий выпуск</h2>
      <p class="text-sm text-wood-600">
        {fallback.length} {fallback.length === 1 ? 'материал' : 'материалов'} из {all.length} в архиве
      </p>
    </div>

    {fallback.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {fallback.map(material => (
          <MaterialCard material={material} />
        ))}
      </div>
    ) : (
      <div class="card p-10 text-center">
        <p class="text-wood-700">
          Пока нет собранных материалов. Выполните <code class="rounded bg-wood-100 px-1.5 py-0.5 text-sm">npm run collect</code>,
          чтобы наполнить выпуск.
        </p>
      </div>
    )}
  </section>

  <section class="border-t border-wood-200 bg-wood-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="mb-6 font-serif text-2xl font-bold text-wood-900">Рубрики</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ['Инструмент', 'Обзоры, сравнения, выбор под задачу'],
          ['Проект/чертёж', 'Готовые чертежи и разборы изготовления'],
          ['Техника и приёмы', 'Рабочие способы, которые экономят время'],
          ['Безопасность', 'Охрана труда, пыль, ЛКМ, защита'],
          ['События/выставки', 'Встречи, мастер-классы, выставки'],
          ['Вдохновение', 'Работы мастеров и идеи для своих проектов']
        ].map(([title, text]) => (
          <a href={withBase(`/archive/?category=${encodeURIComponent(title!)}`)} class="card p-5 transition-colors hover:bg-wood-100">
            <h3 class="font-serif text-lg font-bold text-wood-900">{title}</h3>
            <p class="mt-1.5 text-sm text-wood-600">{text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
